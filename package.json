{
  "name": "moneywise-desktop",
  "version": "1.0.0",
  "description": "Professional desktop app for personal finance, budgeting, and smart money allocation.",
  "main": "out/main/index.js",
  "author": "OpenAI Codex",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "electron-vite preview",
    "backend:start": "node backend/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "npm.cmd run build && electron-builder --win nsis portable",
    "package:mac": "npm.cmd run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.511.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.3",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.moneywise.desktop",
    "productName": "MoneyWise",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
