MONEYWISE_BACKEND_HOST=127.0.0.1
MONEYWISE_BACKEND_PORT=8787
MONEYWISE_BACKEND_DB_PATH=backend-data/moneywise-sync.sqlite
MONEYWISE_BACKEND_SESSION_TTL_DAYS=30
MONEYWISE_BACKEND_AUTH_MODE=password-only
MONEYWISE_BACKEND_LOG_LEVEL=info
MONEYWISE_BACKEND_AUTH_SECRET=replace-with-at-least-32-random-bytes
MONEYWISE_BACKEND_ACCESS_TOKEN_TTL_MINUTES=15
MONEYWISE_PUBLIC_BASE_URL=https://moneywise.example.com
MONEYWISE_TLS_TERMINATED=true
MONEYWISE_BACKUP_DIRECTORY=backend-data/backups
MONEYWISE_BACKUP_MAX_AGE_HOURS=24
MONEYWISE_BACKUP_INTERVAL_HOURS=24

# Unpackaged desktop development overrides only. Packaged production clients
# ignore these values and use the public HTTPS production endpoint in sync-config.ts.
MONEYWISE_SYNC_ENABLED=false
MONEYWISE_SYNC_URL=http://127.0.0.1:8787
MONEYWISE_SYNC_DEVICE_ID=desktop-main
