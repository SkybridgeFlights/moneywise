{
  "expo": {
    "name": "MoneyWise Mobile",
    "slug": "moneywise-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneywise-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.moneywise.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.moneywise.mobile",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-image",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "moneywise": {
        "syncEnabled": true,
        "backendUrl": "https://moneywise-f4jh.onrender.com"
      },
      "router": {},
      "eas": {
        "projectId": "2756e1f6-2ffa-4639-8c73-55fd94d23258"
      }
    },
    "experiments": {
      "reactCompiler": true
    },
    "owner": "wajd17"
  }
}
